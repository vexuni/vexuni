{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vexuni",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "services": [{ "binding": "BUILDER", "service": "vexuni-build" }],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "not_found_handling": "none",
    "run_worker_first": true,
  },
  "vars": {
    // Operator domains: APP_ORIGIN is the canonical origin and
    // APPS_ORIGIN the application gateway's origin.
    "APPS_ORIGIN": "https://apps.vexuni.site",
    "APP_ORIGIN": "https://vexuni.site",
    "WEBHOOK_ALLOWED_HOSTS": "",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vexuni",
      // Replace with your own D1 database_id (`wrangler d1 create vexuni`).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "vexuni-objects",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "REPOSITORIES",
        "class_name": "Repository",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Repository"],
    },
  ],
  "observability": {
    "enabled": true,
  },
  "queues": {
    "producers": [
      {
        "binding": "EVENTS",
        "queue": "vexuni-events",
      },
    ],
    "consumers": [
      {
        "queue": "vexuni-events",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 5,
      },
    ],
  },
  "triggers": {
    "crons": ["*/5 * * * *"],
  },
  "workers_dev": true,
  // Add your custom-domain routes here, e.g.
  // { "pattern": "git.example.com", "custom_domain": true }
}
