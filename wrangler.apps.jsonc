{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vexuni-apps",
  "main": "src/apps-gateway.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "worker_loaders": [
    {
      "binding": "LOADER",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "vexuni",
      // Must match the main Worker's D1 database_id in wrangler.jsonc.
      "database_id": "00000000-0000-0000-0000-000000000000",
    },
  ],
  "r2_buckets": [
    {
      "binding": "OBJECTS",
      "bucket_name": "vexuni-objects",
    },
  ],
  "workers_dev": true,
  "observability": {
    "enabled": true,
  },
}
